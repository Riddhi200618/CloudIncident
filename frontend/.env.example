# CloudIncident Environment Configuration
# Set VITE_USE_MOCK_DATA=true for local UI development and demonstration
# Set VITE_USE_MOCK_DATA=false when connecting to the deployed AWS API Gateway
VITE_USE_MOCK_DATA=true

# AWS API Gateway Base URL (e.g., https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod)
VITE_API_BASE_URL=https://api.example.com/prod
